<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Attendance photos are taken IN the app. There is deliberately no
         gallery picker anywhere, so no READ_MEDIA_IMAGES permission: the
         photo must be taken now, at the site. That omission is the
         cheapest anti-spoofing measure available. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location IS a gate now, and this comment used to say the exact
         opposite. Migrations 0068/0069 verify attendance against a project
         geofence, so the earlier promise (a denial must never block a
         worker from recording attendance) is no longer true, and must not
         be left standing as though it were.

         WHAT ACTUALLY BLOCKS, and what does not:
           Outside the project radius, a mock provider, or a refused
           permission, and the attendance is REFUSED.

           A vague fix, or no fix at all, and it is RECORDED and flagged.
           Uncertainty is never a refusal. A cheap phone under scaffolding
           that cannot hold a fix must still be able to record a day, since
           with the weekly reward attached to a missing day, refusing there
           would cost a worker the bonus for their employer choice of
           hardware.

         FINE, not COARSE: coarse is accurate to roughly 1 to 3 km, which
         cannot tell a 150 m site fence from the next barangay. Android 12
         and later lets the worker grant approximate ONLY even when fine is
         requested; that degrades to a flag, not a lockout. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".AttendanceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.DacsAttendance">

        <!-- singleTop: a widget tap while the app is open must reach this
             activity through onNewIntent. Without it, Android stacks a
             second copy of the app on top of the first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DacsAttendance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget. It opens the flow; it records nothing. -->
        <receiver
            android:name=".widget.DacsTimeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dacs_time_widget_info" />
        </receiver>

        <!-- The app supplies WorkManager's Configuration itself (see
             AttendanceApp) so SubmissionWorker can be injected. The
             default initialiser has to be removed or it wins the race. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
